{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src"]
}
